# Pinned tool versions and checksums. Sourced by bash (scripts/setup.sh) and
# parsed by tests/support.py:read_versions; keep one NAME="value" per line.

# llvm-mingw release tag: https://github.com/mstorsjo/llvm-mingw/releases
LLVM_MINGW_VERSION="20260826"
# sha256 of llvm-mingw-${LLVM_MINGW_VERSION}-ucrt-ubuntu-22.04-x86_64.tar.xz from that release
LLVM_MINGW_SHA256="cee8d2ce3da5145ce4dc882e70d0b0719a783d53a99752c60948fc0659975a65"

# xwin release tag: https://github.com/Jake-Shadle/xwin/releases
XWIN_VERSION="0.10.0"
# sha256 of xwin-${XWIN_VERSION}-x86_64-unknown-linux-musl.tar.gz from that release
XWIN_SHA256="d870eb4b2f390878af6da1ccd3cf321d22fcb72720984853b4be732ae597fc88"

# Oldest clang that setup accepts. The MSVC STL in the pinned Windows SDK
# rejects older compilers (static assertion STL1000).
CLANG_MIN_VERSION="19"
